{
    "name": "listas/listas-de-tarefas",
    "type": "project",
    "description": "Lista de Tarefas app",
    "keywords": ["lista", "tarefas", "todo", "tasks0"],
    "license": "MIT",
    "require-dev": {
        "phpunit/phpunit": "^13.2"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "dev": "php -S localhost:8000 -t public",
        "test": "./vendor/bin/phpunit",
        "feature-test": "mvn -f tests/Feature/Fuctional/pom.xml test"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "monolog/monolog": "^3.10"
    }
}
